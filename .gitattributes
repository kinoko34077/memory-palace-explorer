# Shared specification and implementation: https://github.com/kinoko34077/devflow/issues/1088
# Bootstrap default: LF for portable text; native CRLF for Windows batch scripts.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve packaged application and media artifacts.
*.png -text
*.jpg -text
*.jpeg -text
*.webp -text
*.ico -text
*.icns -text
